rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPermanentAdminData(data) {
      return data.get('role', '') == 'admin'
        && data.get('active', false);
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isConfiguredAdmin() {
      return isSignedIn()
        && (
          authEmail() == 'lebo@oldage.co.za'
          || authEmail() == 'tebogo@oldage.co.za'
        );
    }

    function hasAppAccess() {
      return isSignedIn()
        && (
          isConfiguredAdmin()
          || (
            userDoc().exists()
            && userDoc().data.get('active', false)
          )
        );
    }

    function hasRole(role) {
      return isSignedIn()
        && (
          (role == 'admin' && isConfiguredAdmin())
          || (
            userDoc().exists()
            && userDoc().data.get('active', false)
            && userDoc().data.get('role', '') == role
          )
        );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isConfiguredAdminBootstrap(userId, data) {
      return isSignedIn()
        && userId == request.auth.uid
        && (
          authEmail() == 'lebo@oldage.co.za'
          || authEmail() == 'tebogo@oldage.co.za'
        )
        && data.get('email', null) == authEmail()
        && data.get('uid', null) == request.auth.uid
        && data.get('role', '') == 'admin'
        && data.get('active', false);
    }

    function isConfiguredAdminUserDoc(userId, data) {
      return data != null
        && (
          data.get('email', '').lower() == 'lebo@oldage.co.za'
          || data.get('email', '').lower() == 'tebogo@oldage.co.za'
        )
        && data.get('uid', userId) == userId;
    }

    function preservesConfiguredAdmin(userId, data) {
      return isConfiguredAdminUserDoc(userId, data)
        && data.get('role', '') == 'admin'
        && data.get('active', false);
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function canManageResidents() {
      return isAdmin() || isDoctor();
    }

    function isOwnUserDoc(userId) {
      return isSignedIn()
        && (
          userId == request.auth.uid
          || (
            // Allow users to read their own profile by stored uid/email even when
            // the document is not keyed by the current auth uid.
            resource != null
            && (
              resource.data.get('uid', '') == request.auth.uid
              || resource.data.get('email', '').lower() == authEmail()
            )
          )
        );
    }

    function isValidRole(role) {
      return role == 'admin' || role == 'staff' || role == 'doctor';
    }

    function isUserPayload(data, userId) {
      return data.keys().hasAll(['name', 'email', 'role', 'active', 'uid'])
        && data.name is string
        && data.name.size() > 0
        && data.email is string
        && data.email.size() > 0
        && (!data.keys().hasAll(['dept']) || data.dept is string)
        && data.active is bool
        && isValidRole(data.role)
        && data.uid == userId
        && (!data.keys().hasAll(['createdAt']) || data.createdAt is timestamp);
    }

    function isStaffDirectoryPayload(data) {
      return data.keys().hasAll(['name', 'position', 'department', 'phone', 'email'])
        && data.keys().hasOnly(['name', 'position', 'department', 'phone', 'email', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.position is string
        && data.position.size() > 0
        && data.department is string
        && data.department.size() > 0
        && data.phone is string
        && data.phone.size() > 0
        && data.email is string
        && data.email.size() > 0
        && (!data.keys().hasAll(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAll(['updatedAt']) || data.updatedAt is timestamp);
    }

    function hasStaffUid(data) {
      return data.keys().hasAll(['staffUid']);
    }

    function isValidTaskStatus(status) {
      return status == 'pending'
        || status == 'in-progress'
        || status == 'completed';
    }

    function isValidEventStatus(status) {
      return status == 'scheduled'
        || status == 'in-progress'
        || status == 'completed';
    }

    function isValidInspectionStatus(status) {
      return status == 'compliant'
        || status == 'follow-up'
        || status == 'critical';
    }

    function isTaskPayload(data) {
      return data.keys().hasAll(['desc', 'priority', 'status', 'createdBy'])
        && data.keys().hasOnly(['desc', 'assignedTo', 'dueDate', 'priority', 'notes', 'status', 'createdBy', 'createdAt', 'updatedAt', 'completedAt'])
        && data.desc is string
        && data.desc.size() > 0
        && data.desc.size() <= 500
        && (!data.keys().hasAll(['assignedTo']) || data.assignedTo is string)
        && (!data.keys().hasAll(['dueDate']) || data.dueDate is timestamp)
        && data.priority is string
        && (data.priority == 'high' || data.priority == 'medium' || data.priority == 'low')
        && (!data.keys().hasAll(['notes']) || (data.notes is string && data.notes.size() <= 2000))
        && data.status is string
        && isValidTaskStatus(data.status)
        && data.createdBy is string
        && (!data.keys().hasAll(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAll(['updatedAt']) || data.updatedAt is timestamp)
        && (!data.keys().hasAll(['completedAt']) || data.completedAt is timestamp);
    }

    function isValidRosterShift(shift) {
      return shift == 'morning'
        || shift == 'afternoon'
        || shift == 'night'
        || shift == 'off';
    }

    function isWorkRosterPayload(data) {
      return data.keys().hasAll(['staffEmail', 'staffName', 'day', 'shift'])
        && data.keys().hasOnly(['staffEmail', 'staffName', 'position', 'department', 'day', 'shift', 'updatedAt'])
        && data.staffEmail is string
        && data.staffEmail.size() > 0
        && data.staffName is string
        && data.staffName.size() > 0
        && (!data.keys().hasAll(['position']) || data.position is string)
        && (!data.keys().hasAll(['department']) || data.department is string)
        && data.day is string
        && data.day.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.shift is string
        && isValidRosterShift(data.shift)
        && (!data.keys().hasAll(['updatedAt']) || data.updatedAt is timestamp);
    }

    function isValidFunderType(fundingType) {
      return fundingType == 'grant'
        || fundingType == 'corporate'
        || fundingType == 'government'
        || fundingType == 'individual'
        || fundingType == 'in-kind';
    }

    function isValidEmailAddress(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 320
        && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isNonBlankString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength
        && value.matches('.*[^\\s].*');
    }

    function isFunderPayload(data) {
      return data.keys().hasAll(['name', 'contactPerson', 'fundingType', 'status'])
        && data.keys().hasOnly(['name', 'contactPerson', 'email', 'phone', 'fundingType', 'status', 'notes', 'createdAt', 'updatedAt'])
        && isNonBlankString(data.name, 200)
        && isNonBlankString(data.contactPerson, 200)
        && (!data.keys().hasAll(['email']) || isValidEmailAddress(data.email))
        && (!data.keys().hasAll(['phone']) || isNonBlankString(data.phone, 50))
        && (data.keys().hasAll(['email']) || data.keys().hasAll(['phone']))
        && data.fundingType is string
        && isValidFunderType(data.fundingType)
        && data.status is string
        && (data.status == 'active' || data.status == 'inactive')
        && (!data.keys().hasAll(['notes']) || (data.notes is string && data.notes.size() <= 2000))
        && (!data.keys().hasAll(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAll(['updatedAt']) || data.updatedAt is timestamp);
    }

    function isEventPayload(data) {
      return data.keys().hasAll(['title', 'date', 'status', 'createdBy'])
        && data.keys().hasOnly(['title', 'date', 'type', 'venue', 'coordinator', 'status', 'notes', 'createdBy', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 300
        && data.date is timestamp
        && (!data.keys().hasAll(['type']) || data.type is string)
        && (!data.keys().hasAll(['venue']) || data.venue is string)
        && (!data.keys().hasAll(['coordinator']) || data.coordinator is string)
        && data.status is string
        && isValidEventStatus(data.status)
        && (!data.keys().hasAll(['notes']) || (data.notes is string && data.notes.size() <= 2000))
        && data.createdBy is string
        && (!data.keys().hasAll(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAll(['updatedAt']) || data.updatedAt is timestamp);
    }

    function isInspectionPayload(data) {
      return data.keys().hasAll(['department', 'inspector', 'date', 'status', 'findings', 'createdBy'])
        && data.keys().hasOnly(['department', 'inspector', 'date', 'status', 'findings', 'recommendations', 'createdBy', 'createdAt', 'updatedAt'])
        && data.department is string
        && data.department.size() > 0
        && data.department.size() <= 300
        && data.inspector is string
        && data.inspector.size() > 0
        && data.inspector.size() <= 300
        && data.date is timestamp
        && data.status is string
        && isValidInspectionStatus(data.status)
        && data.findings is string
        && data.findings.size() > 0
        && data.findings.size() <= 5000
        && (!data.keys().hasAll(['recommendations']) || (data.recommendations is string && data.recommendations.size() <= 5000))
        && data.createdBy is string
        && (!data.keys().hasAll(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAll(['updatedAt']) || data.updatedAt is timestamp);
    }

    function isActivityPayload() {
      return request.resource.data.keys().hasAll(['msg', 'date', 'uid'])
        && request.resource.data.msg is string
        && request.resource.data.msg.size() > 0
        && request.resource.data.msg.size() <= 1000
        && request.resource.data.date is timestamp
        && request.resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwnUserDoc(userId) || isAdmin();
      allow create, update: if (isAdmin() || isConfiguredAdminBootstrap(userId, request.resource.data))
        && isUserPayload(request.resource.data, userId)
        && (
          resource == null
          || !isConfiguredAdminUserDoc(userId, resource.data)
          || preservesConfiguredAdmin(userId, request.resource.data)
        );
      allow delete: if isAdmin()
        && !isConfiguredAdminUserDoc(userId, resource.data);
    }

    match /activities/{activityId} {
      allow read: if isAdmin();
      allow create: if hasAppAccess() && isActivityPayload();
      allow update, delete: if isAdmin();
    }

    match /staffDirectory/{staffId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && isStaffDirectoryPayload(request.resource.data);
    }

    match /donations/{docId} {
      allow read, write: if isAdmin();
    }

    match /income/{docId} {
      allow read, write: if isAdmin();
    }

    match /expenditure/{docId} {
      allow read, write: if isAdmin();
    }

    match /funders/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isFunderPayload(request.resource.data)
        && request.resource.data.keys().hasAll(['createdAt', 'updatedAt']);
      allow update: if isAdmin()
        && isFunderPayload(request.resource.data)
        && request.resource.data.keys().hasAll(['updatedAt'])
        && (
          resource == null
          || !resource.data.keys().hasAll(['createdAt'])
          || (
            request.resource.data.keys().hasAll(['createdAt'])
            && request.resource.data.createdAt == resource.data.createdAt
          )
        );
      allow delete: if isAdmin();
    }

    match /leaves/{leaveId} {
      allow read: if isAdmin()
        || (hasAppAccess() && resource != null && resource.data.staffUid == request.auth.uid);
      allow create: if (isAdmin()
          || (
            hasAppAccess()
            && hasStaffUid(request.resource.data)
            && request.resource.data.staffUid == request.auth.uid
          ));
      allow update: if isAdmin()
        && hasStaffUid(resource.data)
        && hasStaffUid(request.resource.data)
        && request.resource.data.staffUid == resource.data.staffUid;
      allow delete: if isAdmin();
    }

    match /workRoster/{entryId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && isWorkRosterPayload(request.resource.data);
    }

    match /residents/{docId} {
      allow read, create: if hasAppAccess();
      allow update, delete: if canManageResidents();
    }

    match /tasks/{docId} {
      allow read: if hasAppAccess();
      allow create, update: if hasAppAccess()
        && isTaskPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    match /events/{docId} {
      allow read: if hasAppAccess();
      allow create, update: if hasAppAccess()
        && isEventPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    match /inspections/{docId} {
      allow read: if hasAppAccess();
      allow create, update: if hasAppAccess()
        && isInspectionPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    match /medications/{docId} {
      allow read, create: if hasAppAccess();
      allow update, delete: if isAdmin();
    }
  }
}
